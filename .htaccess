# Pantallazo · reglas para Apache / LiteSpeed (DoWeb, cPanel)

Options -Indexes
DirectoryIndex index.html

# Pasar el encabezado de sesión a PHP en hostings CGI/FPM
SetEnvIf X-Token "(.+)" HTTP_X_TOKEN=$1
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS.
  # En DonWeb esto ya lo hace el .htaccess de la raíz (así la dirección queda limpia),
  # por eso aquí va desactivado. En otro hosting donde la tienda esté sola en la raíz,
  # quita el # de las tres líneas cuando el certificado SSL esté activo.
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /admin abre el panel
  RewriteRule ^admin/?$ admin.html [L]

  # Bloquear carpetas y archivos privados
  RewriteRule ^(data|plantillas|\.git)(/|$) - [F,L]
</IfModule>

# Archivos que nunca deben verse desde el navegador
<FilesMatch "^(config\.php|config\.ejemplo\.php|router\.php|.*\.(json|md|csv|lock|tmp|log|zip)|\.gitignore|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # La tienda cambia seguido: el navegador puede guardar los archivos,
  # pero debe preguntar al servidor si hay version nueva antes de usarlos.
  # Sin esto, al desplegar queda el HTML nuevo con el JS viejo.
  <FilesMatch "\.(html|js|css|svg|png)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^admin\.(html|js)$">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
